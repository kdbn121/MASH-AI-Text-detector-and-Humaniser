  "bin": {
    "mash-audit": "scripts/audit.mjs",
    "mash-rewrite": "scripts/rewrite-docx.mjs",
    "mash-lint": "scripts/pattern_lint.py"
  },
  "files": [
    "SKILL.md",
    "scripts/",
    "rules/",
    "references/",
    "agents/"
  ],
  "scripts": {
    "test": "node scripts/selftest.mjs",
    "lint": "node scripts/lint-skill.mjs",
    "audit": "node scripts/audit.mjs",
    "live": "python scripts/fetch_patterns.py --force"
  },
  "keywords": [
